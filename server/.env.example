# ChemGuard Server — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env or the service-account JSON to Git.

PORT=5000

# Absolute path to your Firebase service-account JSON file
# Download from Firebase Console > Project Settings > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Your Firebase project ID (visible in Firebase Console)
FIREBASE_PROJECT_ID=your-project-id

# Allowed frontend origin (adjust port if Vite runs elsewhere)
ALLOWED_ORIGIN=http://127.0.0.1:5173
